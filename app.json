{
  "expo": {
    "name": "nutrition-app",
    "slug": "nutrition-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutritionapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nutriscan.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriScan needs camera access to photograph food for nutritional analysis.",
        "NSPhotoLibraryUsageDescription": "NutriScan needs photo library access to select food photos for nutritional analysis."
      }
    },
    "android": {
      "package": "com.nutriscan.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriScan needs photo library access to select food photos for nutritional analysis.",
          "cameraPermission": "NutriScan needs camera access to photograph food for nutritional analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
