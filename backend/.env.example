# -------------------------------------------------------------------
# NutriScan Backend — Environment Variables
# -------------------------------------------------------------------
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
# -------------------------------------------------------------------

# OmniRoute Configuration (required for real food recognition)
# OmniRoute is a local API proxy that routes requests to Gemini models
# using the OpenAI-compatible API format.
#
# If these are not set, the backend falls back to MockVisionProvider.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_MODEL=gemini

# Optional: Retry configuration for OmniRoute multi-model pool
# When one model in your combo fails (quota exceeded, unavailable, etc.),
# the provider will retry, giving OmniRoute a chance to route to a different model.
# OMNIROUTE_MAX_RETRIES=5      # How many attempts before giving up (default: 5)
# OMNIROUTE_RETRY_DELAY=1000   # Base delay in milliseconds between retries (default: 1000)

# USDA FoodData Central API Key (required for nutrition lookup)
# Get a free key at: https://fdc.nal.usda.gov/api-key-signup.html
# Without this key, the nutrition lookup endpoint will return an error.
# Rate limits: 1000 requests/hour per IP with a registered key.
#              DEMO_KEY: 30/hour, 50/day (not recommended).
USDA_API_KEY=

# -------------------------------------------------------------------
# Supabase PostgreSQL & Auth Configuration
# -------------------------------------------------------------------
# Supabase project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Supabase Anon Key (Public key for client requests; safe with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-only secret; bypasses RLS for administrative tasks)
# WARNING: NEVER expose this key in client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY=

