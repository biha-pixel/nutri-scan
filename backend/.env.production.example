# -------------------------------------------------------------------
# NutriScan Backend — Production Environment Variables
# -------------------------------------------------------------------
# This file serves as a template for production deployments (e.g. Vercel).
# Copy these keys into your hosting provider's dashboard; do not commit the real values.

# The current environment context for Next.js
NODE_ENV=production

# -------------------------
# Required APIs
# -------------------------
# Production USDA key, NOT a demo key, with sufficient rate limits
USDA_API_KEY=

# OmniRoute integration variables (replace with direct production provider if omitting proxy)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=

# -------------------------
# Production Supabase
# -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Service Role Key allows bypassing RLS for safe server-side admin operations.
# IT MUST NEVER LEAVE THE SERVER. NEVER START THIS WITH NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
