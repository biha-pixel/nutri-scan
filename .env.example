# -------------------------------------------------------------------
# NutriScan Mobile App — Environment Variables Example
# -------------------------------------------------------------------
# Copy this file to .env.local and populate with your project credentials.
# -------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Custom backend API base URLs
# EXPO_PUBLIC_WEB_API_URL=http://localhost:3001
# EXPO_PUBLIC_API_URL=http://192.168.1.28:3001
